#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# Le changer déconnecte tous les utilisateurs (jetons signés avec l'ancienne valeur).
JWT_SECRET=
WHATSAPP_API_KEY=
ANTHROPIC_API_KEY=
