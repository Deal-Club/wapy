#!/usr/bin/env bash
# Passe le barrage anti-secret sur les fichiers indexes avant chaque commit.
# Active par : git config core.hooksPath .githooks   (une fois par clone)
#
# Limite assumee : on scanne le fichier du repertoire de travail, pas le blob
# indexe. Un `git add` d'un secret suivi d'une edition du fichier passerait donc
# au travers. La CI (.github/workflows/secrets.yml) rattrape ce cas, puisqu'elle
# relit l'arbre tel qu'il a ete pousse.
set -uo pipefail

racine="$(git rev-parse --show-toplevel)"
mapfile -t indexes < <(git diff --cached --name-only --diff-filter=ACMR)
[ "${#indexes[@]}" -eq 0 ] && exit 0

if ! "$racine/tools/scan-secrets.sh" "${indexes[@]}"; then
  printf '\nCommit refuse. En cas d urgence absolue : git commit --no-verify\n' >&2
  exit 1
fi
